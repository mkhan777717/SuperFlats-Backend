# .env

# ==================== GENERAL SETTINGS ====================
NODE_ENV=development
PORT=5000

# ==================== DATABASE SETTINGS ====================
DB_DIALECT=postgres
DB_HOST=localhost
DB_USER=your_db_username
DB_PASS=your_db_password
DB_NAME=your_db_name
DB_PORT=5432

# ==================== AUTHENTICATION ====================
JWT_SECRET=a_very_long_and_secure_random_string

# ==================== EMAIL SERVICE ====================
# You would get these from your email service provider (e.g., SendGrid, Mailgun)
EMAIL_SERVICE_PROVIDER=
EMAIL_USER=
EMAIL_PASS=